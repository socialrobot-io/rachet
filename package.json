{
  "name": "reflow",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "reflow": "dist/src/cli.js"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@11.8.0",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && pnpm build:workflows",
    "build:workflows": "tsx scripts/bundle-workflows.ts",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm check:compose",
    "check:compose": "if docker compose version >/dev/null 2>&1; then REFLOW_DOMAIN=reflow.example.test ACME_EMAIL=ops@example.test REFLOW_FROM=noreply@example.test docker compose -f compose.yaml config --quiet && docker compose -f compose.dev.yaml config --quiet; else echo 'SKIP: Docker Compose plugin unavailable'; fi",
    "dev": "node --env-file=.env --env-file-if-exists=.env.local --import tsx --watch src/server.ts",
    "dev:infra": "docker compose -f compose.dev.yaml up -d",
    "dev:infra:down": "docker compose -f compose.dev.yaml down",
    "dev:worker": "node --env-file=.env --env-file-if-exists=.env.local --import tsx --watch src/worker.ts",
    "dev:dispatcher": "node --env-file=.env --env-file-if-exists=.env.local --import tsx --watch src/dispatcher.ts",
    "format": "prettier --write .",
    "lint": "eslint .",
    "mcp": "tsx src/mcp-stdio.ts",
    "migrate": "node --env-file=.env --env-file-if-exists=.env.local --import tsx src/db/migrate.ts",
    "server": "node dist/server.js",
    "setup": "node --env-file=.env --env-file-if-exists=.env.local --import tsx src/cli.ts setup",
    "start:worker": "node dist/worker.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@better-auth/api-key": "1.7.4",
    "@better-auth/oauth-provider": "1.7.4",
    "@hono/node-server": "1.19.9",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@temporalio/activity": "1.23.0",
    "@temporalio/client": "1.23.0",
    "@temporalio/common": "1.23.0",
    "@temporalio/worker": "1.23.0",
    "@temporalio/workflow": "1.23.0",
    "better-auth": "1.7.4",
    "commander": "14.0.3",
    "drizzle-orm": "0.45.2",
    "hono": "4.13.7",
    "ink": "7.1.1",
    "jose": "6.1.3",
    "pg": "8.16.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-email": "6.9.5",
    "resend": "6.28.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@temporalio/testing": "1.23.0",
    "@types/node": "24.10.1",
    "@types/pg": "8.16.0",
    "@types/react": "19.2.14",
    "drizzle-kit": "0.31.10",
    "eslint": "10.0.3",
    "prettier": "3.8.2",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.56.1",
    "vitest": "4.1.0"
  }
}

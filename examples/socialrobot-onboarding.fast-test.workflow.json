{
  "schemaVersion": "1",
  "description": "FAST TEST copy of SocialRobot onboarding with short waits (seconds, not days).",
  "trigger": {
    "type": "manual"
  },
  "purpose": "marketing",
  "topic": "onboarding",
  "entryNodeId": "check_posts_queued_start",
  "nodes": [
    {
      "id": "check_posts_queued_start",
      "type": "branch",
      "condition": {
        "op": "event_received",
        "eventType": "social.posts_queued"
      },
      "onTrue": "end_habit_established",
      "onFalse": "check_already_connected"
    },
    {
      "id": "check_already_connected",
      "type": "branch",
      "condition": {
        "op": "event_received",
        "eventType": "social.account_connected"
      },
      "onTrue": "wait_day1",
      "onFalse": "check_connected_field"
    },
    {
      "id": "check_connected_field",
      "type": "branch",
      "condition": {
        "op": "exists",
        "value": {
          "path": "contact.accountConnected"
        }
      },
      "onTrue": "wait_day1",
      "onFalse": "locale_welcome"
    },
    {
      "id": "locale_welcome",
      "type": "branch",
      "condition": {
        "op": "eq",
        "left": {
          "path": "contact.locale",
          "default": "en"
        },
        "right": {
          "literal": "es"
        }
      },
      "onTrue": "send_welcome_es",
      "onFalse": "send_welcome_en"
    },
    {
      "id": "send_welcome_en",
      "type": "action",

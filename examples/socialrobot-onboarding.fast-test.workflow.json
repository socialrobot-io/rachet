      "next": "wait_day1",
      "onError": "attention"
    },
    {
      "id": "wait_day1",
      "type": "wait_for_event",
      "eventType": "social.posts_queued",
      "timeoutSeconds": 20,
      "onEvent": "end_habit_established",
      "onTimeout": "check_scheduled_day1"
    },
    {
      "id": "check_scheduled_day1",
      "type": "branch",
      "condition": {
        "op": "event_received",
        "eventType": "social.post_scheduled"
      },

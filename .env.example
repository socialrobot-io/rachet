NODE_ENV=production
PORT=3000
REFLOW_DOMAIN=reflow.example.com
# Required only when enabling the Compose caddy profile (bare-host TLS)
ACME_EMAIL=ops@example.com
PUBLIC_URL=https://reflow.example.com
GOOGLE_ANALYTICS_ID=
DATABASE_URL=postgresql://reflow:change-me@postgres:5432/reflow
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
ALLOW_REGISTRATION=false
REFLOW_SETUP_SECRET=replace-with-at-least-32-random-characters
TRUSTED_ORIGINS=https://reflow.example.com
# Public OAuth registrations accept native-app and loopback callbacks by default.
# Add exact HTTPS origins only for MCP clients you trust.
OAUTH_PUBLIC_REDIRECT_ORIGINS=
OAUTH_PUBLIC_REDIRECT_SCHEMES=cursor
TEMPORAL_ADDRESS=temporal:7233
TEMPORAL_NAMESPACE=reflow
TEMPORAL_TASK_QUEUE=reflow-enrollments
# Generate with: openssl rand -base64 32. Back up securely; losing it makes
# organization integration credentials unreadable.
INTEGRATION_ENCRYPTION_KEY=
# Send-scoped API key and organization for the product welcome SDK client.
# Set both, or leave both empty. The key must not be committed.
REFLOW_API_KEY=
REFLOW_WORKSPACE_ID=
# Authentication mail is deliberately isolated from workflow delivery.
AUTH_RESEND_API_KEY=
AUTH_EMAIL_FROM=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
LOG_LEVEL=info
# Optional configured human OAuth/OIDC provider
OAUTH_PROVIDER_ID=company
OAUTH_DISCOVERY_URL=https://id.example.com/.well-known/openid-configuration
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=

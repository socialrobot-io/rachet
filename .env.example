NODE_ENV=production
PORT=3000
REFLOW_DOMAIN=reflow.example.com
ACME_EMAIL=ops@example.com
PUBLIC_URL=https://reflow.example.com
DATABASE_URL_FILE=/run/secrets/database_url
BETTER_AUTH_SECRET_FILE=/run/secrets/better_auth_secret
ALLOW_REGISTRATION=false
TRUSTED_ORIGINS=https://reflow.example.com
TEMPORAL_ADDRESS=temporal:7233
TEMPORAL_NAMESPACE=reflow
TEMPORAL_TASK_QUEUE=reflow-enrollments
RESEND_API_KEY_FILE=/run/secrets/resend_api_key
RESEND_WEBHOOK_SECRET_FILE=/run/secrets/resend_webhook_secret
REFLOW_FROM=Social Robot <email@example.com>
LOG_LEVEL=info
# Optional configured human OAuth/OIDC provider
OAUTH_PROVIDER_ID=company
OAUTH_DISCOVERY_URL=https://id.example.com/.well-known/openid-configuration
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET_FILE=/run/secrets/oauth_client_secret

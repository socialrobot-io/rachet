NODE_ENV=development
PORT=3000
PUBLIC_URL=http://localhost:3000
DATABASE_URL=postgresql://reflow:reflow@127.0.0.1:5433/reflow
BETTER_AUTH_SECRET=dev-only-change-me-to-at-least-32-chars
ALLOW_REGISTRATION=false
TRUSTED_ORIGINS=http://localhost:3000,http://localhost:5173
# Comma-separated HTTPS origins allowed for public OAuth client callbacks.
OAUTH_PUBLIC_REDIRECT_ORIGINS=
OAUTH_PUBLIC_REDIRECT_SCHEMES=cursor
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=reflow
TEMPORAL_TASK_QUEUE=reflow-enrollments
REFLOW_FROM=Reflow <onboarding@resend.dev>
# Optional: real sends. Put the key in secrets/resend_api_key (mode 600).
# RESEND_API_KEY_FILE=./secrets/resend_api_key
# RESEND_WEBHOOK_SECRET_FILE=./secrets/resend_webhook_secret
LOG_LEVEL=info

NODE_ENV=development
PORT=3000
PUBLIC_URL=http://localhost:3000
DATABASE_URL=postgresql://reflow:reflow@127.0.0.1:5433/reflow
BETTER_AUTH_SECRET=dev-only-change-me-to-at-least-32-chars
ALLOW_REGISTRATION=false
TRUSTED_ORIGINS=http://localhost:3000,http://localhost:5173
# Cursor currently completes MCP OAuth through this reviewed web callback.
OAUTH_PUBLIC_REDIRECT_ORIGINS=https://www.cursor.com
OAUTH_PUBLIC_REDIRECT_SCHEMES=cursor
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=reflow
TEMPORAL_TASK_QUEUE=reflow-enrollments
# Put authentication credentials in .env.local. pnpm dev generates the
# integration encryption key there when missing; connect Resend in the UI.
# AUTH_RESEND_API_KEY=
# AUTH_EMAIL_FROM="Rachet <login@your-verified-auth-domain.example>"
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# REFLOW_SETUP_SECRET is generated in .env.local when it is not configured.
LOG_LEVEL=info

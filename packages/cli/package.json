{
  "name": "@socialrobot-io/rachet",
  "version": "0.2.1",
  "description": "CLI for Rachet, the open-source journey engine for agents",
  "license": "AGPL-3.0-only",
  "type": "module",
  "bin": { "rachet": "./dist/cli.js" },
  "engines": { "node": ">=22.0.0" },
  "files": ["dist", "README.md", "LICENSE"],
  "keywords": ["mcp", "ai-agents", "journey-orchestration", "temporal", "resend", "email-automation"],
  "homepage": "https://github.com/socialrobot-io/rachet#readme",
  "repository": { "type": "git", "url": "git+https://github.com/socialrobot-io/rachet.git", "directory": "packages/cli" },
  "bugs": { "url": "https://github.com/socialrobot-io/rachet/issues" },
  "publishConfig": { "access": "public" },
  "scripts": {
    "build": "esbuild src/cli.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist/cli.js --packages=external",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pack:check": "pnpm pack --dry-run"
  },
  "dependencies": {
    "@resvg/resvg-js": "2.6.2",
    "beautiful-mermaid": "1.1.3",
    "commander": "14.0.3",
    "esbuild": "0.25.12",
    "ink": "7.1.1",
    "ink-picture": "2.1.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-email": "6.9.5",
    "zod": "4.3.6"
  },
  "devDependencies": { "@types/react": "19.2.14", "typescript": "5.9.3" }
}
